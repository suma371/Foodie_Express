# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Replace with your MongoDB Atlas or Local MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/foodie_express

# JWT Configuration
# Use a long, random string for production
JWT_SECRET=your_jwt_secret_here

# Payment Configuration (Optional)
# Get these from your Razorpay Dashboard
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
